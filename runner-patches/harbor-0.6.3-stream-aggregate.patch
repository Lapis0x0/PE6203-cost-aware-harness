+async def _cah_acompletion(completion_kwargs: dict, stream: bool):
+    """cost-aware-harness patch: optionally stream and reassemble a ModelResponse with stream_chunk_builder."""
+    if not stream:
+        return await litellm.acompletion(**completion_kwargs)
+    kw = {**completion_kwargs, "stream": True, "stream_options": {"include_usage": True}}
+    chunks = [c async for c in await litellm.acompletion(**kw)]
+    return litellm.stream_chunk_builder(chunks, messages=completion_kwargs.get("messages"))
